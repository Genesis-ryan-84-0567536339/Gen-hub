# Gen Hub Reverse Proxy & Automatic Let's Encrypt TLS Configuration (E1)
# Place your domain in GEN_HUB_DOMAIN or substitute {$GEN_HUB_DOMAIN}

{$GEN_HUB_DOMAIN:localhost} {
    encode gzip zstd

    # Reverse proxy to Gen Hub core service within Docker container network
    reverse_proxy gen-hub:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output stdout
        format json
    }
}
