# Gen Hub Environment Configuration Example
# Copy to .env or source before running Gen Hub

# Domain & Public URL (E1)
# Domain should be a valid FQDN, e.g., mcp.example.com
GEN_HUB_DOMAIN=mcp.example.com
OBOT_SERVER_HOSTNAME=https://mcp.example.com
OBOT_SERVER_UI_HOSTNAME=https://mcp.example.com
GEN_HUB_ENABLE_TLS=true
GEN_HUB_TLS_MODE=letsencrypt

# Server Ports
OBOT_SERVER_PORT=8080
GEN_HUB_HTTP_PORT=8080
GEN_HUB_HTTPS_PORT=8443

# Database configuration (Defaults to internal container postgres if unset)
# POSTGRES_USER=obot
# POSTGRES_PASSWORD=obot
# POSTGRES_DB=obot
# OBOT_SERVER_DSN=postgresql://obot:obot@localhost:5432/obot
