{
  "name": "gen-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node --test tests/ui*_test.mjs",
    "check": "node --check server/main.mjs && node --check public/app.js && bash -n install.sh && python3 -m unittest discover -s tests -p '*_test.py'"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  },
  "dependencies": {
    "js-yaml": "^5.4.2"
  }
}
